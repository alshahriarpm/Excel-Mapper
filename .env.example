# ---------------------------------------------------------------------------
# Supabase — copy this file to .env.local and fill in values from your project
# Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------

# Public project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public key (safe to expose; RLS protects the data).
# New format: publishable key (sb_publishable_...). Legacy: anon key.
# Either name works — the app checks publishable first, then anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key   # legacy alternative

# Secret key — SERVER ONLY. Never expose to the browser. REQUIRED for admin
# features (seeding, creating/blocking/deleting users, force-delete).
# New format: secret key (sb_secret_...). Legacy: service_role key.
SUPABASE_SECRET_KEY=sb_secret_your-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # legacy alternative

# ---------------------------------------------------------------------------
# Direct Postgres connection — needed only for the DB scripts: `pnpm db:apply`,
# `pnpm db:check`, `pnpm db:reload`. They connect through the Supabase pooler.
# SUPABASE_DB_PORT: 6543 = transaction pooler (default), 5432 = session pooler.
# Both work for these scripts (schema DDL applies fine over 6543); if a future
# multi-statement DDL is ever rejected on 6543, set SUPABASE_DB_PORT=5432.
# The password is the DATABASE password from Dashboard → Settings → Database —
# NOT the sb_secret_… API key above.
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_REGION=ap-south-1
SUPABASE_DB_PORT=6543

# Base URL of the deployed app (used for auth redirects). Locally this is
# http://localhost:3000; on Vercel set it to your production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed super-admin (created automatically on server startup if these are set
# and Supabase is reachable). Idempotent — safe to leave set.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=choose-a-strong-password
SEED_ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# Demo mode: run the whole app with seeded in-memory data (no Supabase).
# Login is email-based — sign in with SEED_ADMIN_EMAIL for admin, any other
# email explores the HR side. Set to false (or remove) for real Supabase auth.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=false
